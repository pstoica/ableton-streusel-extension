{
  "name": "streusel-extension",
  "type": "module",
  "version": "0.1.0",
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc --noEmit && tsx build.ts",
    "build:prod": "tsc --noEmit && tsx build.ts --production",
    "start": "tsx build.ts && extensions-cli run",
    "watch": "tsx build.ts --watch",
    "test": "tsc --noEmit && tsx test/run.ts",
    "test:run": "tsx test/run.ts",
    "package": "npm run build:prod && extensions-cli package -o streusel-$npm_package_version.ablx"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:/Users/patrick/Downloads/extensions-sdk-1.0.0-beta.0/ableton-extensions-cli-1.0.0-beta.0.tgz",
    "@ableton-extensions/sdk": "file:/Users/patrick/Downloads/extensions-sdk-1.0.0-beta.0/ableton-extensions-sdk-1.0.0-beta.0.tgz",
    "@types/node": "^25.9.1",
    "esbuild": "0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
